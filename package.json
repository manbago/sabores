{
  "name": "sabor-de-espana",
  "version": "1.0.2",
  "description": "Sabor de España: The Hoops Challenge",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:desktop": "electron-packager . SaborDeEspana --platform=win32 --arch=x64 --out=dist --icon=assets/images/icon.ico --app-version=1.0.2 --app-copyright=\"Manuel Bago Cobo\" --win32metadata.ProductName=\"Sabor de España\" --win32metadata.CompanyName=\"Manuel Bago Cobo\" --win32metadata.FileDescription=\"The Hoops Challenge\" --overwrite",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.manbago.sabordeespana",
    "productName": "Sabor de España",
    "directories": {
      "output": "dist/installer"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/images/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "SaborDeEspana_Setup.exe"
    },
    "files": [
      "**/*",
      "!dist",
      "!.git",
      "!node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/*.d.ts",
      "!README.md"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manbago/sabores.git"
  },
  "keywords": [],
  "author": "Manuel Bago Cobo",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/manbago/sabores/issues"
  },
  "homepage": "https://github.com/manbago/sabores#readme",
  "devDependencies": {
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^3.0.1",
    "electron-packager": "^17.1.2",
    "png-to-ico": "^3.0.1"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  }
}

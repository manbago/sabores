{
  "name": "sabor-de-espana",
  "version": "1.1.0",
  "description": "Sabor de España: The Hoops Challenge",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:desktop": "electron-packager . SaborDeEspana --platform=win32 --arch=x64 --out=dist --icon=assets/images/icon.ico --app-version=1.0.2 --ignore=dist --overwrite",
    "build:steam:win": "electron-packager . SaborDeEspana --platform=win32 --arch=x64 --out=dist/steam_win --icon=assets/images/icon.ico --app-version=1.0.2 --ignore=dist --overwrite && copy /Y game_actions_4596230.vdf dist\\steam_win\\SaborDeEspana-win32-x64\\",
    "build:steam:mac": "electron-packager . SaborDeEspana --platform=darwin --arch=x64 --out=dist/steam_mac --app-version=1.0.2 --ignore=dist --overwrite && copy /Y game_actions_4596230.vdf dist\\steam_mac\\SaborDeEspana-darwin-x64\\",
    "build:steam:linux": "electron-packager . SaborDeEspana --platform=linux --arch=x64 --out=dist/steam_linux --app-version=1.0.2 --ignore=dist --overwrite && copy /Y game_actions_4596230.vdf dist\\steam_linux\\SaborDeEspana-linux-x64\\",
    "build:steam:all": "npm run build:steam:win && npm run build:steam:mac && npm run build:steam:linux",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.manbago.sabordeespana",
    "productName": "Sabor de España",
    "directories": {
      "output": "dist/installer"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/images/icon.ico"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Game",
      "executableName": "SaborDeEspana"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/images/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "SaborDeEspana_Setup.exe"
    },
    "files": [
      "**/*",
      "!dist",
      "!.git",
      "!node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/*.d.ts",
      "!README.md"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manbago/sabores.git"
  },
  "keywords": [],
  "author": "Manuel Bago Cobo",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/manbago/sabores/issues"
  },
  "homepage": "https://github.com/manbago/sabores#readme",
  "devDependencies": {
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^3.0.1",
    "electron-packager": "^17.1.2",
    "png-to-ico": "^3.0.1"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  }
}
